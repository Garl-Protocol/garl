# garl.ai — archived (2026-09-24). Static sunset site; every other path is
# answered with the sunset page and HTTP 410. Revival: docs/runbooks/sunset.md.
{
	admin off
	auto_https off
}

:3000 {
	root * /srv
	header X-GARL-Status "archived"

	@page file {
		try_files {path} {path}.html {path}/index.html
	}
	handle @page {
		rewrite * {file_match.relative}
		file_server
	}

	handle {
		rewrite * /index.html
		file_server {
			status 410
		}
	}
}
